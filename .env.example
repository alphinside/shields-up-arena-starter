# Local development and deployment configuration.
# Copy to .env and fill in your project values.

GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# BigQuery, MCP Toolbox, agent runtime, and Model Armor run in us-central1.
# app/agent.py pins the Gemini model client to "global" separately.
GOOGLE_CLOUD_LOCATION=us-central1
BIGQUERY_LOCATION=us-central1

# Published Shields Up Arena scorer service account email (shared by organizers).
# scripts/deploy.sh and scripts/grant-scorer.sh bind only reasoningEngines.get
# and reasoningEngines.query on your single agent runtime instance.
SCORER_SERVICE_ACCOUNT=

# Do not set TOOLBOX_URL here. Local runs default to http://127.0.0.1:5000, and
# scripts/deploy.sh passes the private Cloud Run URL via --update-env-vars.
# Anything set in .env is copied into agent runtime by agents-cli deploy.
